# Phase A template. Copy to .env only if one does not already exist; never commit .env.
# Use the Atlas driver SRV hostname. Do not paste a password into the repository.
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-hostname>/?retryWrites=true&w=majority
MONGODB_DATABASE=chargeguard

# Optional workaround for hotspot DNS SRV EBADRESP (process only, no system changes):
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Required for API and database commands: set a private INGEST_API_KEY (at least 24 characters).
# INGEST_API_KEY=<private-random-key>

# Datadog credentials and US1 site belong in the existing local Agent configuration.
# The application does not need DATADOG_API_KEY or DATADOG_SITE.

# Phase B local DogStatsD metrics: no Datadog key is needed in the application.
DD_METRICS_ENABLED=false
DD_AGENT_HOST=127.0.0.1
DD_DOGSTATSD_PORT=8125
DD_ENV=dev
# macOS Agent file logs; installer creates this directory with application-write/Agent-read access.
# CHARGEGUARD_LOG_FILE=/usr/local/var/log/chargeguard/api.jsonl

# Vercel Stage A: server-only read credential, at least 32 random characters.
# BFF_READ_API_KEY=<random-service-read-key>
# Set DD_ENV=prod and DD_METRICS_ENABLED=false on Vercel.
# Never configure CHARGEGUARD_LOG_FILE or a loopback Agent sink there.
