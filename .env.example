# Phase A template. Copy to .env only if one does not already exist; never commit .env.
# Use the Atlas driver SRV hostname. Do not paste a password into the repository.
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-hostname>/?retryWrites=true&w=majority
MONGODB_DATABASE=chargeguard

# Optional workaround for hotspot DNS SRV EBADRESP (process only, no system changes):
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Required for API and database commands: set a private INGEST_API_KEY (at least 24 characters).
# INGEST_API_KEY=<private-random-key>

# Datadog is reserved for Phase B; no live integration in Phase A.
DATADOG_API_KEY=<set-locally-when-authorized>
DATADOG_SITE=<your-datadog-region>
