# Preparation only. Copy to .env locally after Atlas configuration; never commit .env.
# Use the Atlas driver SRV hostname. Do not paste a password into the repository.
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-hostname>/?retryWrites=true&w=majority
MONGODB_DATABASE=chargeguard

# Reserved for implementation after 2026-10-17; no live integration yet.
DATADOG_API_KEY=<set-locally-when-authorized>
DATADOG_SITE=<your-datadog-region>
