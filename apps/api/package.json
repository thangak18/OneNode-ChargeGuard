{
  "name": "@chargeguard/api",
  "private": true,
  "version": "0.1.0",
  "description": "ChargeGuard Phase A NestJS telemetry API",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.ts",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed-virtual.ts",
    "replay:acn": "tsx scripts/replay-acn.ts",
    "smoke:atlas": "tsx scripts/smoke-atlas.ts",
    "verify:atlas": "tsx scripts/verify-atlas.ts",
    "smoke:observability": "tsx scripts/smoke-observability.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "dotenv": "^17.2.0",
    "mongodb": "^7.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
