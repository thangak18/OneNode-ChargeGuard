# ChargeGuard web app (Next.js) environment template.
# Copy to .env.local and fill in. .env* is gitignored and never committed.

# The private NestJS ingest API key. Injected server-side by the BFF route
# handler at src/app/api/v1/[...path]/route.ts; never exposed to the browser
# and never prefixed with NEXT_PUBLIC_. Used only for local development
# mutations, which are disabled in production. Use the API's INGEST_API_KEY.
NEST_API_KEY=<private-ingest-key>

# NestJS API origin (defaults to http://127.0.0.1:3001). Override only when
# the API runs on a different host/port during local development. Production
# read-only requests require this value to use HTTPS.
NEST_API_BASE_URL=http://127.0.0.1:3001
