    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Explicit synthetic fault events (counts)",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "faults",
                "query": "sum:chargeguard.fault.simulated{service:chargeguard-api,env:dev} by {charger_id}.as_count()"
              }
            ]
          }
        ]
      }
    }
  ],
