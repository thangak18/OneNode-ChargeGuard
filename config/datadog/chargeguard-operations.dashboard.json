        "title": "Virtual charger 04: observed operational state (one-hot)",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "status",
                "query": "max:chargeguard.charger.operational_status{service:chargeguard-api,env:dev,charger_id:demo-charger-04} by {status,source}"
              }
